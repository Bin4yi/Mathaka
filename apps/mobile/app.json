{
  "expo": {
    "name": "Mathaka",
    "slug": "mathaka",
    "scheme": "mathaka",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/generated/brand/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.mathaka.app"
    },
    "android": {
      "package": "lk.mathaka.app",
      "adaptiveIcon": {
        "backgroundColor": "#E3F1EE",
        "foregroundImage": "./assets/generated/brand/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/generated/brand/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/generated/brand/logo.png",
          "imageWidth": 160,
          "backgroundColor": "#FBF8F1",
          "dark": {
            "image": "./assets/generated/brand/logo.png",
            "backgroundColor": "#14181F"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#145A52",
          "sounds": [
            "./assets/sounds/chime_low.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mathaka uses the camera to photograph prescriptions and pills on the calibration mat. Photos stay on this phone.",
          "photosPermission": "Mathaka can use a photo of a prescription or a pill that you already took. Photos stay on this phone.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
