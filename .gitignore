# Mathaka — what git should NOT track.
# https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ---------------------------------------------------------------------------
# Secrets and local settings (never commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
credentials.json
service-account*.json
.npmrc.local

# ---------------------------------------------------------------------------
# Node / npm workspaces
# ---------------------------------------------------------------------------
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
.pnpm-store/
*.tgz
.npm/
.eslintcache
*.tsbuildinfo
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Expo / React Native (native folders are generated by prebuild — never edit by hand)
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
apps/mobile/ios/
apps/mobile/android/
.kotlin/
*.orig.*
.metro-health-check*
*.apk
*.aab
*.ipa
build/
.tmp-web/

# ---------------------------------------------------------------------------
# AI models (downloaded at runtime, large)
# ---------------------------------------------------------------------------
*.gguf
*.onnx
*.safetensors
*.bin
/models/
.cache/
hf_cache/

# ---------------------------------------------------------------------------
# Python (laptop helper + eval)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
helper/.venv*/
eval/.venv*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Arduino / firmware build output
# ---------------------------------------------------------------------------
firmware/**/build/
firmware/**/.pio/
*.elf
*.hex

# ---------------------------------------------------------------------------
# Video project (HyperFrames): keep the source + assets, drop build output.
# The final small video lives in docs/media/mathaka-demo.mp4.
# ---------------------------------------------------------------------------
videos/*/snapshots/
videos/*/renders/
videos/*/.hyperframes/
videos/*/.media/
videos/*/node_modules/
videos/*/assets/music/bed.wav
videos/*/assets/photos/fetch.mjs.log
*.mov
*.mkv

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.log
